{
  "name": "shadowlist-templates",
  "version": "0.0.0",
  "private": true,
  "description": "Templates, visual components and example apps for shadowlist.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komplete-io/shadowlist-templates.git"
  },
  "packageManager": "yarn@4.19.0",
  "workspaces": [
    "packages/shadowlist-utils",
    "packages/shadowlist-wasm-utils",
    "examples/shadowlist-fabric-example",
    "examples/shadowlist-macos-example"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p packages/shadowlist-utils/tsconfig.json && tsc -p examples/shadowlist-fabric-example/tsconfig.json && tsc -p examples/shadowlist-macos-example/tsconfig.json --noEmit && yarn workspace shadowlist-wasm-utils run typecheck",
    "typecheck:web": "tsc -p examples/shadowlist-web-example/tsconfig.json --noEmit",
    "test": "yarn workspace shadowlist-utils run test",
    "test:wasm": "yarn workspace shadowlist-wasm-utils run test",
    "build": "yarn workspace shadowlist-utils run build",
    "build:wasm": "yarn workspace shadowlist-wasm-utils run build",
    "format": "prettier --write --config .prettierrc --ignore-path .gitignore --ignore-path .prettierignore .",
    "format:check": "prettier --check --config .prettierrc --ignore-path .gitignore --ignore-path .prettierignore .",
    "docs:check": "node scripts/check-readmes.mjs",
    "release:utils": "yarn workspace shadowlist-utils npm publish --tolerate-republish"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@evilmartians/lefthook": "^2.2.2",
    "@react-native/eslint-config": "0.88.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "resolutions": {
    "on-headers": "^1.1.0"
  }
}
