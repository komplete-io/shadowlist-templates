{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "shadowlist-wasm": [
        "../../../shadowlist/packages/shadowlist-wasm/dist/index.d.ts"
      ],
      "shadowlist-wasm/loader": [
        "../../../shadowlist/packages/shadowlist-wasm/dist/ShadowListWasmLoader.d.ts"
      ],
      "shadowlist-wasm-utils": [
        "../../packages/shadowlist-wasm-utils/src/index.ts"
      ]
    }
  },
  "include": ["src"],
  "references": [{ "path": "../../packages/shadowlist-wasm-utils" }]
}
