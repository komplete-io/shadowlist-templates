# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ShadowListExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Layout checks only: SHADOWRULER=1 pod install links ShadowRuler from the checkout next to
  # this repository (SHADOWRULER_ROOT overrides it). react-native.config.js adds its module.
  if ENV['SHADOWRULER'] == '1'
    pod 'ShadowRuler', :path => ENV['SHADOWRULER_ROOT'] || File.join(__dir__, '../../../../shadowruler')
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
    # ShadowRuler refuses release builds unless allowed. The layout check runs on Release.
    if ENV['SHADOWRULER'] == '1'
      installer.pods_project.targets.each do |target|
        next unless target.name == 'ShadowRulerReactNative'
        target.build_configurations.each do |build_config|
          conditions = build_config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] || '$(inherited)'
          build_config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = "#{conditions} SHADOWRULER_ALLOW_RELEASE"
        end
      end
    end
  end
end
